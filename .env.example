# Copy to .env.local and fill in real values. NEVER commit .env.local.
# Get a key at https://aistudio.google.com/apikey (billing must be enabled; images have no free tier).
IMAGE_API_KEY=your-key-here
IMAGE_PROVIDER=gemini
# Cheapest/fastest Gemini image model, ~$0.034 per image (~$0.20 per new subject).
IMAGE_MODEL=gemini-3.1-flash-lite-image
# Gemini image size: 1K = 1024x1024 (the lite model only supports 1K).
IMAGE_SIZE=1K
MAX_SETS_PER_IP_PER_HOUR=3
MAX_IMAGES_PER_DAY=300
